---
import Icon from '../Icon.astro';
import type { IconName } from '../icons';
import { useT, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
  /** heading level when used outside the home page */
  id?: string;
}
const { lang, id = 'how' } = Astro.props;
const t = useT(lang);
const icons: IconName[] = ['phone', 'pin', 'wrench'];
---

<section class="section" id={id} aria-labelledby={`${id}-title`}>
  <div class="container">
    <header class="section-head" data-reveal>
      <p class="eyebrow">{t.how.eyebrow}</p>
      <h2 class="section-title" id={`${id}-title`}>{t.how.title}</h2>
    </header>
    <ol class="steps" role="list">
      {
        t.how.steps.map((text, i) => (
          <li class="step" data-reveal style={`--d:${i * 0.12}s`}>
            <span class="step__top">
              <span class="step__icon" aria-hidden="true">
                <Icon name={icons[i]} />
              </span>
              <span class="step__num" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
            </span>
            <p class="step__text">
              <span class="visually-hidden">
                {t.how.step} {i + 1}:{' '}
              </span>
              {text}
            </p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .steps {
    position: relative;
    display: grid;
    gap: 20px;
    margin: 0;
  }
  .step {
    position: relative;
    display: grid;
    gap: 22px;
    padding: 28px 28px 32px;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
    transition:
      transform 0.5s var(--ease),
      border-color 0.5s var(--ease),
      opacity 0.8s var(--ease);
  }
  .step:hover {
    transform: translateY(-5px);
    border-color: rgb(210 71 11 / 0.45);
  }
  .step__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
  }
  .step__icon {
    width: 52px;
    height: 52px;
    display: grid;
    place-items: center;
    border-radius: 14px;
    background: var(--primary-soft);
    color: var(--accent);
    transition: transform 0.5s var(--ease-back);
  }
  .step:hover .step__icon {
    transform: rotate(-10deg) scale(1.08);
  }
  .step__icon :global(.icon) {
    width: 24px;
    height: 24px;
  }
  .step__num {
    color: var(--step-num);
    font-size: 3rem;
    font-weight: 900;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    transition: color 0.5s var(--ease);
  }
  .step:hover .step__num {
    color: var(--accent);
  }
  .step__text {
    font-size: 1.0625rem;
    font-weight: 700;
    line-height: 1.5;
  }
  @media (min-width: 900px) {
    .steps {
      grid-template-columns: repeat(3, 1fr);
      gap: 28px;
    }
    /* dashed road connecting the steps */
    .steps::before {
      content: '';
      position: absolute;
      top: 54px;
      left: 8%;
      right: 8%;
      height: 2px;
      background: repeating-linear-gradient(90deg, var(--line-strong) 0 10px, transparent 10px 20px);
      z-index: -1;
    }
  }
</style>
