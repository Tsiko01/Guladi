---
/**
 * Gallery: every photo in src/assets/photos/work/<category>/, the owner's own
 * photos first. Filter chips per service; a lightbox (<dialog>) with
 * keyboard + swipe navigation lives in src/scripts/gallery.ts.
 */
import { getImage } from 'astro:assets';
import Icon from '../Icon.astro';
import Photo from '../Photo.astro';
import { services } from '../../config/services';
import { useT, type Lang } from '../../i18n';
import { categories, getGallery, type Category } from '../../lib/photos';

interface Props {
  lang: Lang;
  /** only this category (service pages) */
  only?: Category;
  /** heading id / section id */
  id?: string;
  title?: string;
}
const { lang, only, id = 'gallery', title } = Astro.props;
const t = useT(lang);
const label = (c: Category) => (c === 'other' ? t.gallery.other : services.find((s) => s.slug === c)!.title[lang]);

const items = await Promise.all(
  getGallery()
    .filter((g) => !only || g.category === only)
    .map(async (g) => {
      const full = await getImage({ src: g.image, widths: [1080, Math.min(1800, g.image.width)].filter((w, i, a) => w <= g.image.width && a.indexOf(w) === i), format: 'webp', quality: 72 });
      return { ...g, full: full.srcSet.attribute, fullSrc: full.src };
    }),
);
const cats = categories.filter((c) => items.some((i) => i.category === c));
const INITIAL = only ? items.length : 8;
---

{
  items.length > 0 && (
    <section class:list={['section', { 'section--alt': !only }]} id={id} aria-labelledby={`${id}-title`} data-gallery-root>
      <div class="container">
        <header class="section-head" data-reveal>
          {!only && <p class="eyebrow">{t.gallery.eyebrow}</p>}
          <h2 class="section-title" id={`${id}-title`}>
            {title ?? t.gallery.title}
          </h2>
        </header>

        {!only && cats.length > 1 && (
          <div class="filters" role="group" aria-label={t.gallery.filter} data-reveal>
            <button type="button" class="chip" aria-pressed="true" data-filter="all">
              {t.gallery.all}
              <span class="chip__n">{items.length}</span>
            </button>
            {cats.map((c) => (
              <button type="button" class="chip" aria-pressed="false" data-filter={c}>
                {label(c)}
                <span class="chip__n">{items.filter((i) => i.category === c).length}</span>
              </button>
            ))}
          </div>
        )}

        <ul class:list={['grid', { 'grid--few': only }]} role="list" data-grid>
          {items.map((it, i) => (
            <li class="tile" data-cat={it.category} hidden={i >= INITIAL} data-extra={i >= INITIAL ? '' : undefined}>
              <button type="button" class="tile__btn" data-full={it.full} data-full-src={it.fullSrc} data-alt={it.alt[lang]} data-label={label(it.category)}>
                <Photo name={`work/${it.id}`} alt={it.alt[lang]} sizes="(min-width: 1280px) 310px, (min-width: 1024px) 24vw, (min-width: 640px) 32vw, 50vw" maxWidth={828} />
                <span class="tile__shade" aria-hidden="true">
                  <span class="tile__cat">{label(it.category)}</span>
                  <span class="tile__zoom">
                    <Icon name="expand" />
                  </span>
                </span>
                <span class="visually-hidden">{t.gallery.open}</span>
              </button>
            </li>
          ))}
        </ul>

        {items.length > INITIAL && (
          <div class="more">
            <button type="button" class="btn btn--outline" data-more>
              {t.gallery.more}
              <span class="chip__n">+{items.length - INITIAL}</span>
            </button>
          </div>
        )}
      </div>
    </section>
  )
}

{
  items.length > 0 && (
    <dialog class="lb" aria-label={t.gallery.dialog} data-lightbox>
      <figure class="lb__figure">
        <img class="lb__img" src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" alt="" data-lb-img />
        <figcaption class="lb__cap">
          <span class="lb__label" data-lb-label />
          <span data-lb-cap />
          <span class="lb__count" data-lb-count />
        </figcaption>
      </figure>
      <button type="button" class="lb__btn lb__close" aria-label={t.gallery.close} data-lb-close>
        <Icon name="x" />
      </button>
      <button type="button" class="lb__btn lb__prev" aria-label={t.gallery.prev} data-lb-prev>
        <Icon name="chevronLeft" />
      </button>
      <button type="button" class="lb__btn lb__next" aria-label={t.gallery.next} data-lb-next>
        <Icon name="chevronRight" />
      </button>
    </dialog>
  )
}

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin: -16px 0 32px;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 42px;
    padding: 0 16px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: var(--surface);
    color: var(--muted);
    font-size: 0.875rem;
    font-weight: 700;
    transition:
      background-color 0.3s var(--ease),
      border-color 0.3s var(--ease),
      color 0.3s var(--ease),
      transform 0.3s var(--ease);
  }
  .chip:hover {
    color: var(--text);
    border-color: var(--accent);
  }
  .chip:active {
    transform: scale(0.96);
  }
  .chip[aria-pressed='true'] {
    border-color: var(--primary);
    background: var(--primary);
    color: #fff;
  }
  .chip__n {
    min-width: 22px;
    padding: 1px 7px;
    border-radius: 999px;
    background: color-mix(in srgb, currentColor 14%, transparent);
    font-size: 0.75rem;
    text-align: center;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    margin: 0;
  }
  .tile[hidden] {
    display: none;
  }
  .tile.is-in {
    animation: tile-in 0.6s var(--ease) both;
    animation-delay: var(--d, 0s);
  }
  .tile__btn {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    padding: 0;
    overflow: hidden;
    overflow: clip;
    border: 0;
    border-radius: var(--radius);
    background: var(--night-2);
    cursor: zoom-in;
  }
  .tile__btn :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.9s var(--ease);
  }
  .tile__btn:hover :global(img) {
    transform: scale(1.08);
  }
  .tile__shade {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 8px;
    padding: 12px;
    background: linear-gradient(to top, rgb(10 11 13 / 0.85), transparent 60%);
    color: #fff;
    opacity: 0;
    transition: opacity 0.4s var(--ease);
  }
  .tile__btn:hover .tile__shade,
  .tile__btn:focus-visible .tile__shade {
    opacity: 1;
  }
  .tile__cat {
    font-size: 0.8125rem;
    font-weight: 700;
    line-height: 1.3;
    text-align: left;
  }
  .tile__zoom {
    flex: none;
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--orange);
  }
  .tile__zoom :global(.icon) {
    width: 16px;
    height: 16px;
  }
  .more {
    display: flex;
    justify-content: center;
    margin-top: 32px;
  }
  @media (hover: none) {
    .tile__shade {
      opacity: 1;
      background: linear-gradient(to top, rgb(10 11 13 / 0.7), transparent 45%);
    }
    .tile__zoom {
      display: none;
    }
  }
  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    }
  }
  @media (min-width: 1024px) {
    .grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  /* service pages: few photos, centred */
  .grid--few {
    grid-template-columns: repeat(auto-fit, minmax(160px, 300px)) !important;
    justify-content: center;
  }
  @keyframes tile-in {
    from {
      opacity: 0;
      transform: translateY(16px) scale(0.97);
    }
  }

  /* ─── lightbox ─── */
  .lb {
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: #fff;
    overflow: hidden;
  }
  .lb::backdrop {
    background: rgb(6 7 8 / 0.94);
    backdrop-filter: blur(6px);
  }
  .lb[open] {
    display: grid;
    place-items: center;
    animation: lb-in 0.35s var(--ease) both;
  }
  .lb__figure {
    display: grid;
    justify-items: center;
    gap: 14px;
    width: 100%;
    padding: 64px 16px 24px;
  }
  .lb__img {
    max-width: min(100%, 1400px);
    max-height: calc(100dvh - 170px);
    width: auto;
    height: auto;
    border-radius: var(--radius);
    box-shadow: 0 30px 80px -20px rgb(0 0 0 / 0.8);
    transition: opacity 0.25s var(--ease);
  }
  .lb__img.is-loading {
    opacity: 0.3;
  }
  .lb__cap {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 6px 14px;
    max-width: 900px;
    color: #d8dadd;
    font-size: 0.9375rem;
    text-align: center;
  }
  .lb__label {
    padding: 2px 10px;
    border-radius: 999px;
    background: var(--orange);
    color: #fff;
    font-size: 0.8125rem;
    font-weight: 700;
  }
  .lb__count {
    color: #a9adb3;
    font-variant-numeric: tabular-nums;
  }
  .lb__btn {
    position: fixed;
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    padding: 0;
    border: 1px solid rgb(255 255 255 / 0.2);
    border-radius: 50%;
    background: rgb(20 21 24 / 0.7);
    color: #fff;
    transition:
      background-color 0.3s var(--ease),
      transform 0.3s var(--ease);
  }
  .lb__btn:hover {
    background: var(--orange);
  }
  .lb__btn :global(.icon) {
    width: 22px;
    height: 22px;
  }
  .lb__close {
    top: 14px;
    right: 14px;
  }
  .lb__prev,
  .lb__next {
    top: 50%;
    translate: 0 -50%;
  }
  .lb__prev {
    left: 14px;
  }
  .lb__next {
    right: 14px;
  }
  @media (max-width: 639px) {
    .lb__prev,
    .lb__next {
      top: auto;
      bottom: 18px;
      translate: none;
    }
    .lb__figure {
      padding-bottom: 84px;
    }
  }
  @keyframes lb-in {
    from {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .tile.is-in,
    .lb[open] {
      animation: none;
    }
  }
</style>
